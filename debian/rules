#!/usr/bin/make -f

# ouch's build script renders man pages and shell completions into this
# directory when the variable is set.
export OUCH_ARTIFACTS_FOLDER := $(CURDIR)/artifacts

%:
	dh $@

override_dh_auto_clean:
	cargo clean
	rm -rf artifacts

override_dh_auto_build:
	cargo build --release

override_dh_auto_install:
	install -Dm0755 target/release/ouch debian/ouch/usr/bin/ouch
	set -e; for m in artifacts/*.1; do \
		install -Dm0644 "$$m" "debian/ouch/usr/share/man/man1/$$(basename "$$m")"; \
	done
	install -Dm0644 artifacts/ouch.bash debian/ouch/usr/share/bash-completion/completions/ouch
	install -Dm0644 artifacts/ouch.fish debian/ouch/usr/share/fish/vendor_completions.d/ouch.fish
	install -Dm0644 artifacts/_ouch debian/ouch/usr/share/zsh/vendor-completions/_ouch
